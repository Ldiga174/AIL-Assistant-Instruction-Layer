{
  "ai_behavior": {
    "language": "russian",
    "priority": "working_code_first",
    "initialization": {
      "entry_point": "project.init.md",
      "architecture": "ai-system/project.init.md",
      "mandatory_checks": "prestart.checklist",
      "logging": "ailog.md",
      "task_source": "task.todo.json"
    },
    "rules": [
      "Always start with project.init.md",
      "Read ai-system/project.init.md for full architecture map",
      "Run prestart.checklist before tasks",
      "Log all actions to ailog.md",
      "Do not modify working code without request",
      "No agent makes final decisions — only AIL controls the system",
      "OpenCode does not execute commands",
      "OpenClaw does not generate code",
      "Use modern practices (2024-2026)"
    ],
    "workflow": {
      "1": "Read project.init.md",
      "2": "Read ai-system/project.init.md (architecture map)",
      "3": "Check prestart.checklist",
      "4": "On failure — stop and report",
      "5": "On success — read ailog.md",
      "6": "Execute tasks from task.todo.json",
      "7": "End session with summary in ailog.md"
    }
  },
  "project_meta": {
