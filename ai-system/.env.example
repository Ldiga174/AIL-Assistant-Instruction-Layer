# AIL System Environment Configuration
# Copy to .env and fill in real values

# Logging
LOG_LEVEL=INFO

# Default project repository path
DEFAULT_REPO=.

# Agent timeouts (seconds)
OPENCODE_TIMEOUT=300
OPENCLAW_TIMEOUT=120

# Max retries per task
MAX_RETRIES=3

